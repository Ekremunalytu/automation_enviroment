# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
env/
venv/
*.env

# Distribution / Packaging
dist/
build/
*.egg-info/

# Unit Test / Coverage
htmlcov/
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
.hypothesis/
.pytest_cache/

# IDE / Editor
.idea/
.vscode/
*.swp
*.swo
.DS_Store
# .claude/ stays ignored, EXCEPT the secret-guard hook. settings.json is
# intentionally untracked so local permission edits stay local (use
# .claude/settings.local.json, also ignored, for machine-specific overrides).
.claude/*
!.claude/hooks/
.claude/hooks/*
!.claude/hooks/guard-secrets.py

# Project Specific
output/
# Ad-hoc analiz çıktıları / activation_report scratch (operator-local).
results/
# extensions/ stores marketplace-downloaded VSIXes and extracted payloads; keep
# them out of git but track the security fixtures the CI lane depends on.
extensions/*
!extensions/malicious/
!extensions/extrace.fixture-chat-0.0.1/
!extensions/extrace.fixture-theme-0.0.1/
!extensions/extrace.fixture-snippet-0.0.1/
!extensions/extrace.fixture-keybinding-0.0.1/
!extensions/extrace.fixture-cmd-0.0.1/
.env
!.env.example
node_modules/
# macOS Finder duplicates ("node_modules 2") and Apple iCloud
# .nosync variants ("node_modules.nosync") created when an operator
# moves node_modules out of an iCloud-synced directory.
node_modules[ .]*

# Linting & Type Checking
.mypy_cache/
.ruff_cache/

# Logs
*.log

# Security Reports
bandit-report.json

# Operator-local scratch (do not track repo-root note files; canonical
# trackers live under documents/ — automation_todo.md, REFACTOR_STATUS.md)
/problems.md
/todo.md
