# =============================================================================
# OPTIONAL DIRECT DATABASE URL OVERRIDE
# If set, this takes priority over POSTGRES_* variables in application code.
# =============================================================================
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/extrace

# =============================================================================
# DATABASE CONFIGURATION (DatabaseSettings)
# Prefix: POSTGRES_
# =============================================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=extrace

# SQLAlchemy engine tuning
POSTGRES_ECHO=false
POSTGRES_POOL_SIZE=20
POSTGRES_POOL_MAX_OVERFLOW=40
POSTGRES_POOL_TIMEOUT=30
POSTGRES_POOL_RECYCLE=3600
POSTGRES_POOL_PRE_PING=true

# Docker-internal DB connection values for API container
POSTGRES_DOCKER_HOST=postgres
POSTGRES_DOCKER_PORT=5432

# Docker postgres healthcheck values
POSTGRES_HEALTHCHECK_INTERVAL=10s
POSTGRES_HEALTHCHECK_TIMEOUT=5s
POSTGRES_HEALTHCHECK_RETRIES=5

# Test database values
POSTGRES_TEST_PORT=5434
POSTGRES_TEST_DOCKER_PORT=5432
POSTGRES_TEST_DB=test_db
POSTGRES_TEST_HEALTHCHECK_INTERVAL=10s
POSTGRES_TEST_HEALTHCHECK_TIMEOUT=5s
POSTGRES_TEST_HEALTHCHECK_RETRIES=5

# =============================================================================
# API CONFIGURATION (APISettings)
# Prefix: API_
# ADR 0007 — defaults bind loopback only. Set EXTRACE_ALLOW_LAN=1 to swap
# the wildcard form back in (only after the runbook checklist below).
# =============================================================================
API_HOST=127.0.0.1
API_PORT=8000
API_WORKERS=1
API_DEBUG=false
API_HEALTH_STATUS=OK

# OpenAPI docs routes
API_DOCS_URL=/docs
API_REDOC_URL=/redoc
API_OPENAPI_URL=/openapi.json

# Middleware tuning
API_GZIP_MINIMUM_SIZE=2000
API_CORS_ALLOW_ORIGINS=http://localhost:3000
API_CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS
API_CORS_ALLOW_HEADERS=Content-Type,Authorization
API_CORS_ALLOW_CREDENTIALS=false

# =============================================================================
# PROJECT CONFIGURATION (ProjectSettings)
# Prefix: PROJECT_
# =============================================================================
PROJECT_NAME=ExTrace API
PROJECT_ENV=dev
PROJECT_VERSION=1.0.0
PROJECT_DESCRIPTION=VS Code Extension Dynamic Analysis & Automation Platform
PROJECT_STATUS=Active

# Path to the directory containing extension folders.
# - Docker: This MUST match the mount point in docker-compose.yml
# - Local: Relative path from project root or absolute path.
PROJECT_EXTENSION_DIR=extensions

# Output directory for activation reports and analysis artifacts.
PROJECT_OUTPUT_DIR=output

# Offline intake directory for the Marketplace "Offline" tab (air-gapped runs).
# Drop raw .vsix packages here; the API scans and stages them through the same
# hardened extract path as a marketplace download. Defaults under EXTENSION_DIR
# so the existing ./extensions bind mount already exposes it in the API
# container — no compose change needed.
PROJECT_OFFLINE_DIR=extensions/offline

# =============================================================================
# SECURITY NOTICE — ADR 0007 (Local Network Binding Discipline)
# =============================================================================
# ExTrace ships with no built-in authentication; access control depends on
# the loopback (127.0.0.1) binding default plus the operator-host trust
# assumption (ADR 0001, ADR 0002 §5). The defaults above (API_HOST,
# API_CORS_*) and the docker-compose port mappings are loopback-only.
#
# To expose services on the LAN (multi-host lab, remote analyst workstation):
#
#   1. Read documents/runbooks/lan-exposure.md — the operator-side hardening
#      checklist (firewall rules, authenticating reverse proxy in front of
#      port 8000, explicit CORS allow-list, rotated PostgreSQL password).
#   2. Rotate POSTGRES_PASSWORD: the dev-default `postgres` is reachable
#      today only because the listener binds 127.0.0.1.
#   3. Set EXTRACE_ALLOW_LAN=1 in the environment (host-mode dev server).
#
# Compose port mappings carry an explicit `127.0.0.1:` prefix; that is
# structural, not env-driven. To expose Docker services on the LAN, edit
# docker-compose.yml directly or run host-mode via `make dev-lan`.
#
# CDP (port 9222) is absent from the default `docker compose up` service
# set; it ships behind the `debug` profile (`make up-debug` /
# `docker compose --profile debug up`).
# =============================================================================

# =============================================================================
# EXECUTOR CONTAINER CONFIGURATION
# Used by docker-compose and executor/start.sh
# =============================================================================
EXECUTOR_NODE_MAJOR=20
EXECUTOR_VSCODE_CHANNEL=stable
EXECUTOR_VSCODE_VERSION=1.116.0

EXECUTOR_DISPLAY=:99
EXECUTOR_SCREEN=1920x1080x24
EXECUTOR_VNC_HOST=localhost
EXECUTOR_VNC_PORT=5900
EXECUTOR_NOVNC_PORT=6080
EXECUTOR_CDP_PORT=9222
EXECUTOR_STARTUP_SLEEP_SECONDS=1
EXECUTOR_VSCODE_LOG_LEVEL=trace

EXECUTOR_EXTENSIONS_HOST_PATH=./extensions
EXECUTOR_EXTENSIONS_CONTAINER_PATH=/extensions-input
EXECUTOR_OUTPUT_HOST_PATH=./output
EXECUTOR_OUTPUT_CONTAINER_PATH=/results

EXECUTOR_MEM_LIMIT=4g
EXECUTOR_CPUS=2.0
# /dev/shm size for the in-container VS Code (Electron/Chromium) renderer.
# Docker's 64MB default is exhausted by cumulative load late in a layered scan
# and crashes the renderer ("Target crashed" -> fatal_ui_crash -> run_quality
# inconclusive). Charged against EXECUTOR_MEM_LIMIT above. Bump to 2g for very
# heavy targets if crashes persist.
EXECUTOR_SHM_SIZE=1g

# =============================================================================
# STATIC ANALYZER (ES-2, ADR 0016)
# =============================================================================
# Hardened static analysis pre-check container. Reuses the EXECUTOR_*_HOST_PATH
# mounts above for the extensions input (ro) + results (rw). Feature flag stays
# OFF until the ES-5 close-out flips it after smoke evidence passes.
STATIC_ANALYZER_CONTAINER_NAME=automation_static_analyzer
STATIC_ANALYZER_DOCKER_EXEC_TIMEOUT=60
STATIC_ANALYZER_MEM_LIMIT=1g
STATIC_ANALYZER_CPUS=1.0
STATIC_ANALYSIS_ENABLED=true
STATIC_ANALYSIS_TIMEOUT_BUDGET_S=30

# =============================================================================
# LOCAL DEV / MAKEFILE HELPERS
# =============================================================================
TEST_DB_WAIT_SECONDS=3

# =============================================================================
# OPTIONAL EXTRACE OVERRIDES
# =============================================================================
# Optional: Path to a VS Code settings.json the harness will copy into
# the workspace under test (read at executor/flows/playwright/settings.py).
# Default: harness ships its own settings.
# EXTRACE_VSCODE_SETTINGS_JSON=

# Optional: When set to 1/true/yes, skip the boot-time recovery sweep
# of analysis_jobs rows left in 'running' state from a prior crash
# (read at main.py). Default: recovery on.
# EXTRACE_SKIP_JOB_RECOVERY=

# Optional: epoch-anchored run identifier stamped onto every emitted
# log record by ``appcore.logging`` (W14-5 sub-commit 2). Propagated
# across the host -> docker exec boundary so a single scan run
# produces a correlatable log stream end-to-end (worker thread +
# heartbeat thread + executor container). When unset, the logger
# factory falls back to a process-local default. Operators usually
# set this from the orchestrator (CI, scan launcher) for cross-host
# log correlation.
# EXTRACE_EPOCH_RUN_ID=
