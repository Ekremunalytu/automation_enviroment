# =============================================================================
# DATABASE CONFIGURATION (DatabaseSettings)
# Prefix: POSTGRES_
# =============================================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=extrace

# Test Database Port (for docker-compose postgres_test service)
POSTGRES_TEST_PORT=5434

# =============================================================================
# API CONFIGURATION (APISettings)
# Prefix: API_
# =============================================================================
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
API_DEBUG=true

# =============================================================================
# PROJECT CONFIGURATION (ProjectSettings)
# Prefix: PROJECT_
# =============================================================================
PROJECT_NAME="ExTrace API"
PROJECT_ENV=dev
PROJECT_VERSION=1.0.0
PROJECT_EXTENSION_DIR=extensions
